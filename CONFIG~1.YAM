  #   Magna, SolarEdge. See SETUP.md "Companies without a clean feed".


# --- What counts as a match -----------------------------------------------
# A job is a STRONG match if a primary keyword appears in the TITLE.
# It's a POSSIBLE match if a keyword appears only in the description.
roles:
  power_electronics:
    - "power electronics"
    - "inverter"
    - "dc-dc"
    - "dc dc"
    - "motor drive"
    - "traction"
    - "power stage"
    - "sic"
    - "gan"
    - "onboard charger"
    - "obc"
    - "bms"
  hardware_validation:
    - "hardware validation"
    - "hw validation"
    - "board bring-up"
    - "bring up"
    - "validation engineer"
    - "dvt"
    - "evt"
  systems_engineering:
    - "systems engineer"
    - "system engineering"
    - "integration engineer"
    - "verification and validation"
    - "v&v"
  test_engineering:
    - "test engineer"
    - "test engineering"
    - "characterization"
    - "reliability engineer"
    - "ate "

# Drop a job if the title contains any of these (case-insensitive).
exclude_title:
  - "sales"
  - "recruiter"


# --- Early career / new grad filter ---------------------------------------
# Only roles that pass this filter are kept. See matcher.py for the logic.
early_career:
  # Hard reject: if the TITLE contains any of these, it's too senior.
  seniority_exclusions:
    - "senior"
    - "sr."
    - "staff"
    - "principal"
    - "lead"
    - "manager"
    - "director"
    - "expert"
    - "distinguished"
    - "head of"
    - "vp"
    - "iii"          # Engineer III and up = too senior
    - "iv"
    - "intern"       # you want new grad, not intern (remove if you want interns too)

  # Strong positive signals of an early-career role (checked in title + description).
  signals:
    - "new grad"
    - "new graduate"
    - "recent graduate"
    - "early career"
    - "early-career"
    - "early in career"
    - "entry level"
    - "entry-level"
    - "university graduate"
    - "college graduate"
    - "associate engineer"
    - "engineer i"
    - "engineer 1"
    - "junior"
    - "rotational"
    - "new college grad"

  # Reject if the description requires MORE than this many years of experience.
  max_years_experience: 2

  # true  = only keep roles with a clear early-career signal (fewer, higher confidence)
  # false = also keep roles with no level info at all, tagged "level unclear"
  strict: false

# Only keep jobs whose location matches one of these substrings.
# Leave empty [] to accept any location.
locations:
  - "United States"
  - "USA"
  - "CA"
  - "Remote"


# --- Output ---------------------------------------------------------------
output:
  google_sheet_id: "12RZp5WJYh70WpMULfIkBHFS_zO4xLdMFUTe4Ged-MsA"            # paste your Sheet ID here
  email_to: "stephanieschaupp2@berkeley.edu"
  email_from: "stephanieschaupp2@gmail.com"                 # your Gmail address
  digest_only: false             # true = never send instant emails, just the daily digest
